    {
      "parameters": {
        "jsCode": "let sistema = `\nVocê é um assistente virtual inteligente, útil e educado.\n\nREGRAS IMPORTANTES:\n- Responda sempre em português do Brasil.\n- Seja natural e conversacional.\n- Seja curto e direto.\n- Nunca invente informações.\n- Nunca invente fórmulas matemáticas.\n- Nunca mude de assunto.\n- Nunca diga frases aleatórias.\n- Nunca repita saudações excessivamente.\n- Não finja emoções humanas.\n- Se não souber algo, diga claramente.\n- Explique de forma didática.\n- Responda no máximo em 5 linhas.\n`;\n\nconst historico = $input.all().slice(-6);\n\nlet conversa = \"\";\n\nfor (const item of historico) {\n\n  if (\n    item.json.mensagem &&\n    item.json.role\n  ) {\n\n    conversa += `${item.json.role}: ${item.json.mensagem}\\n`;\n  }\n}\n\nconst pergunta = $('Webhook-chat').first().json.body.mensagem;\n\nconst prompt = `\n${sistema}\n\nHistórico:\n${conversa}\n\nUsuário: ${pergunta}\n\nAssistente:\n`;\n\nreturn [\n  {\n    json: {\n      mensagem: prompt,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ],
      "id": "7731b388-456e-4b00-a2e5-9b2ed2d2aa5e",
      "name": "code_context"
    },
